{
  "rewrites": [
    {
      "source": "/.well-known/assetlinks.json",
      "destination": "/assetlinks.json"
    },
    {
      "source": "/sitemap.xml",
      "destination": "/api/sitemap"
    },
    {
      "source": "/(anuncio|finca)/:slug",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": ".*([Bb]ot|[Cc]rawl|[Ss]pider|[Ss]lurp|BingPreview|MicrosoftPreview|Google-InspectionTool|GoogleOther|Facebot|facebookexternalhit|WhatsApp|ChatGPT-User|Perplexity-User|Claude-User|Claude-SearchBot).*"
        }
      ],
      "destination": "/api/seo?path=/$1/:slug"
    },
    {
      "source": "/precios/:slug",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": ".*([Bb]ot|[Cc]rawl|[Ss]pider|[Ss]lurp|BingPreview|MicrosoftPreview|Google-InspectionTool|GoogleOther|Facebot|facebookexternalhit|WhatsApp|ChatGPT-User|Perplexity-User|Claude-User|Claude-SearchBot).*"
        }
      ],
      "destination": "/api/seo?path=/precios/:slug"
    },
    {
      "source": "/c/:cat/:prov",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": ".*([Bb]ot|[Cc]rawl|[Ss]pider|[Ss]lurp|BingPreview|MicrosoftPreview|Google-InspectionTool|GoogleOther|Facebot|facebookexternalhit|WhatsApp|ChatGPT-User|Perplexity-User|Claude-User|Claude-SearchBot).*"
        }
      ],
      "destination": "/api/seo?path=/c/:cat/:prov"
    },
    {
      "source": "/c/:cat",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": ".*([Bb]ot|[Cc]rawl|[Ss]pider|[Ss]lurp|BingPreview|MicrosoftPreview|Google-InspectionTool|GoogleOther|Facebot|facebookexternalhit|WhatsApp|ChatGPT-User|Perplexity-User|Claude-User|Claude-SearchBot).*"
        }
      ],
      "destination": "/api/seo?path=/c/:cat"
    },
    {
      "source": "/(precios|fincas|mapa|seguridad|acerca|preguntas-frecuentes)",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": ".*([Bb]ot|[Cc]rawl|[Ss]pider|[Ss]lurp|BingPreview|MicrosoftPreview|Google-InspectionTool|GoogleOther|Facebot|facebookexternalhit|WhatsApp|ChatGPT-User|Perplexity-User|Claude-User|Claude-SearchBot).*"
        }
      ],
      "destination": "/api/seo?path=/$1"
    },
    {
      "source": "/",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": ".*([Bb]ot|[Cc]rawl|[Ss]pider|[Ss]lurp|BingPreview|MicrosoftPreview|Google-InspectionTool|GoogleOther|Facebot|facebookexternalhit|WhatsApp|ChatGPT-User|Perplexity-User|Claude-User|Claude-SearchBot).*"
        }
      ],
      "destination": "/api/seo?path=/"
    },
    {
      "source": "/((?!api/|assets/|demo/|favicon|llms\\.txt|robots\\.txt|[0-9a-f]{32}\\.txt).*)",
      "destination": "/index.html"
    }
  ],
  "crons": [
    {
      "path": "/api/indexnow",
      "schedule": "45 13 * * *"
    }
  ],
  "headers": [
    {
      "source": "/(.well-known/assetlinks.json|assetlinks.json)",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/json"
        },
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        }
      ]
    },
    {
      "source": "/sw.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        },
        {
          "key": "Service-Worker-Allowed",
          "value": "/"
        }
      ]
    }
  ]
}
